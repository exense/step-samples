<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The Step .NET keyword API is part of Step Enterprise and is published on the
         exense NuGet repository, which requires Step Enterprise customer credentials.
         Configure them once with "dotnet nuget update source exense", passing your
         user name and password (see the README). -->
    <add key="exense" value="https://nexus-enterprise.exense.ch/repository/exense-nuget/" />
  </packageSources>
  <!-- Without this mapping, NuGet queries every source for every package, and the
       credentialed exense feed answers 401 for public packages such as Microsoft.Playwright,
       which fails the whole restore. -->
  <packageSourceMapping>
    <packageSource key="exense">
      <package pattern="StepApi*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>