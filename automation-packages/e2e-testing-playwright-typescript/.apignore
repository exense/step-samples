nodejs-keywords/tests/
nodejs-keywords/keywords/
nodejs-keywords/tsconfig.test.json
nodejs-keywords/*.tsbuildinfo
# Recreated by the Step Node agent at runtime; never ship a stale copy
nodejs-keywords/agent-fork-libs/
