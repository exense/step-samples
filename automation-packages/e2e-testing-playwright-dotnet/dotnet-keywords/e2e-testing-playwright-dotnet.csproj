<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>e2e-testing-playwright-dotnet</AssemblyName>
    <RootNamespace>Step.Examples.E2ETesting.Playwright</RootNamespace>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Playwright drives browsers through a Node-based driver, and each target
         platform needs its own ~110 MB Node runtime. Ship only the driver for the
         Step agent's platform; 'all' would bloat the package to ~536 MB.
         For local runs on another OS, override it:
             dotnet build -p:PlaywrightPlatform=win32_x64 -->
    <PlaywrightPlatform Condition="'$(PlaywrightPlatform)' == ''">linux-x64</PlaywrightPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StepApiFunction" Version="1.6.0" />
    <PackageReference Include="StepApiKeyword" Version="1.6.0" />
    <PackageReference Include="StepApiReporting" Version="1.6.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.2.2" />
    <PackageReference Include="MSTest.TestFramework" Version="3.2.2" />
  </ItemGroup>
</Project>